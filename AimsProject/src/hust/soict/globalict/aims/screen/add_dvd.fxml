<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="50.0" right="50.0" top="20.0" />
   </padding>
   <children>
      <Label text="ADD NEW DVD" textFill="AQUA">
         <font>
            <Font size="36.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label prefWidth="100.0" text="Title:" />
            <TextField fx:id="tfTitle" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label prefWidth="100.0" text="Category:" />
            <TextField fx:id="tfCategory" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label prefWidth="100.0" text="Director:" />
            <TextField fx:id="tfDirector" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label prefWidth="100.0" text="Length:" />
            <TextField fx:id="tfLength" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label prefWidth="100.0" text="Cost ($):" />
            <TextField fx:id="tfCost" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <Button fx:id="btnAdd" mnemonicParsing="false" style="-fx-background-color: red;" text="Add to Store" textFill="WHITE">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
</VBox>